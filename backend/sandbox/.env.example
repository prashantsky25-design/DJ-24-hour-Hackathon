# ─────────────────────────────────────────────
#  ARES Module 2 — Environment Variables
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# E2B API key — get yours at https://e2b.dev/dashboard
E2B_API_KEY=your_e2b_api_key_here

# ── LLM Debugger (Self-Healing Agent) ────────────────────────────────────────
# PRIMARY: Google Gemini 1.5 Flash — fast, free via Google AI Studio
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# FALLBACK: Groq — used if GEMINI_API_KEY is empty
# Get key FREE at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model to use for Groq fallback
# Options: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768
DEBUGGER_MODEL=llama-3.3-70b-versatile

# Maximum self-healing retry attempts per execution
MAX_HEAL_ATTEMPTS=3

# Sandbox timeout (seconds) — hard ceiling per execution
SANDBOX_TIMEOUT_SECONDS=300

# E2B sandbox template ID (use "base" for default Python runtime)
E2B_TEMPLATE=base

# SQLite DB path for Logs Saver
SQLITE_DB_PATH=./data/research_memory.db

# Server config
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info
