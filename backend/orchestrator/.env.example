# ─────────────────────────────────────────────
#  ARES Module 1 — Orchestrator Environment Variables
#  Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# OpenAI API key — required for:
#   1. Paper Reader with GPT-4o Vision
#   2. LLM-based task decomposition (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API key — alternative to OpenAI for task planning (optional)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model selection for task decomposition
ARES_OPENAI_MODEL=gpt-4o-mini
ARES_ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Sandbox API endpoint (Module 2)
SANDBOX_API_URL=http://localhost:8001/api/sandbox/execute

# ArXiv Radar configuration
ENABLE_ARXIV_RADAR=false  # Set to "true" to enable background ArXiv monitoring
ARXIV_RADAR_INTERVAL_HOURS=12  # How often to check for new papers

# Server config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Frontend CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
